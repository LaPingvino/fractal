# Fractal with the spaces work, from LaPingvino/fractal (branch spaces).
# Modelled on Arch's own fractal package (archlinux/packaging/packages/fractal).
pkgname=fractal-spaces-git
_branch=spaces
pkgver=0
pkgrel=1
pkgdesc="Matrix group messaging app — with spaces support (AI-assisted fork branch)"
arch=(x86_64 aarch64)
url="https://github.com/LaPingvino/fractal"
license=(GPL-3.0-only)
depends=(
  dconf emoji-font fontconfig gdk-pixbuf2 glib2 glibc glycin glycin-gtk4 graphene
  gst-plugins-bad-libs gst-plugins-base-libs gst-plugin-gtk4 gstreamer gtk4 gtksourceview5
  hicolor-icon-theme lcms2 libadwaita libgcc libpipewire libseccomp libshumate openssl
  org.freedesktop.secrets pango sqlite
)
makedepends=(blueprint-compiler clang cmake dart-sass git libwebp meson rust xdg-desktop-portal)
optdepends=('gst-plugins-good: for video support')
provides=(fractal)
conflicts=(fractal)
source=("fractal::git+$url.git#branch=$_branch")
sha256sums=(SKIP)

pkgver() {
  cd fractal
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  export CARGO_HOME="$srcdir/build/cargo-home"
  cd fractal
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

# The build's environment, the same for build() and package(): meson install
# runs cargo again, and with other flags or another CARGO_HOME it rebuilds —
# under fakeroot, fetching git dependencies as root (failed 2026-11-06).
_cargo_env() {
  export CARGO_HOME="$srcdir/build/cargo-home"
  # Fractal's release profile asks for full debug info with thin LTO and one
  # codegen unit; on a CI runner the final rustc then runs out of memory
  # (SIGKILL, 2026-11-06). Line tables keep backtraces readable at a
  # fraction of the memory; LTO and the codegen units stay as upstream.
  export CARGO_PROFILE_RELEASE_DEBUG=line-tables-only
  # makepkg's debug option appends -C debuginfo=2 to RUSTFLAGS, which comes
  # after the profile's setting and wins: line tables there too.
  RUSTFLAGS="${RUSTFLAGS//-C debuginfo=2/-C debuginfo=line-tables-only}"
  export RUSTFLAGS
  # C code in the crates (cc) sees CFLAGS too: the same in both steps
  CFLAGS+=' -ffat-lto-objects'
}

build() {
  _cargo_env
  arch-meson fractal build
  meson compile -C build
}

package() {
  _cargo_env
  meson install -C build --destdir "$pkgdir"
}
